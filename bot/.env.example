# Пример настроек VK-бота. На сервере скопировать в файл .env и заполнить.
# РЕАЛЬНЫЙ .env В GIT НЕ КОММИТИТЬ (он в .gitignore).

# Ключ доступа сообщества VK (Управление → Настройки → Работа с API → Ключи доступа)
VK_GROUP_TOKEN=

# Числовой VK-id владельца (кто управляет ботом). Узнать можно так:
# оставить 0, написать боту любое сообщение — он ответит твоим id, потом вписать сюда.
ALLOWED_VK_ID=0

# Папка для входящих .xlsx (создаётся автоматически)
INCOMING_DIR=/srv/catalog/bot/price

# Путь к upload.py
UPLOAD_SCRIPT=/srv/catalog/scripts/upload.py

# Интерпретатор Python (в venv обычно указывается путь к venv/bin/python)
PYTHON_BIN=python3

# Таймаут запуска upload.py, секунды
UPLOAD_TIMEOUT=600
