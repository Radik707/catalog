# Пример настроек веб-загрузчика. На сервере скопировать в .env и заполнить.
# РЕАЛЬНЫЙ .env В GIT НЕ КОММИТИТЬ (он в .gitignore).

# Секретный сегмент в URL — длинная случайная строка.
# Страница будет доступна по https://<домен>/<APP_SECRET>
# Сгенерировать можно: python -c "import secrets; print(secrets.token_urlsafe(24))"
APP_SECRET=

# Папка для входящих .xlsx (создаётся автоматически)
INCOMING_DIR=/srv/catalog/uploader/price

# Путь к upload.py
UPLOAD_SCRIPT=/srv/catalog/scripts/upload.py

# Интерпретатор Python (в venv — путь к venv/bin/python, чтобы upload.py
# запускался с openpyxl/gspread/google-auth)
PYTHON_BIN=/srv/catalog/.venv/bin/python

# Таймаут запуска upload.py, секунды
UPLOAD_TIMEOUT=600

# Адрес/порт встроенного сервера (за nginx обычно 127.0.0.1:8000)
HOST=127.0.0.1
PORT=8000

# Архив последней загруженной партии (для кнопки «Показать файлы» в Telegram)
LAST_BATCH_DIR=/opt/apps/catalog/uploader/last_batch

# Порог «подозрительно мало товаров»: предупредить, если загрузилось
# меньше этой доли от прошлого раза (0.5 = меньше половины)
WARN_RATIO=0.5

# --- Telegram-бот администратора (уведомления + кнопки) ---
# Токен бота от @BotFather
TELEGRAM_TOKEN=
# Telegram-id владельца (узнать: запустить бота с OWNER_CHAT_ID=0, написать /start)
OWNER_CHAT_ID=0
# Прокси для доступа к api.telegram.org (Telegram в РФ ограничен), напр.:
TG_PROXY=socks5h://127.0.0.1:1080
